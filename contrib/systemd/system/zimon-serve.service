[Unit]
Description=Serve Kiwix ZIM files (kiwix-serve via zimon)
Documentation=https://github.com/kazie/zimon
Wants=network-online.target
After=network-online.target

[Service]
User=zimon
Group=zimon
Environment=ZIMON_CONFIG=/etc/zimon/config.toml
# zimon writes library.xml and runs kiwix-serve as its child, which reloads
# the library on its own when zimon adds, updates or removes a ZIM.
ExecStart=/usr/local/bin/zimon serve --no-color
Restart=on-failure

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/srv/zim /var/lib/zimon

[Install]
WantedBy=multi-user.target
