# Shared look for every demo. Included with: Source docs/tapes/common/settings.tape
Require zimon
Require fakekiwix
Set Shell "bash"
Set Theme "Catppuccin Mocha"
Set FontSize 18
Set Width 1280
Set Height 640
Set Padding 24
Set Margin 0
Set WindowBar Colorful
Set BorderRadius 8
Set TypingSpeed 55ms
Set CursorBlink false
